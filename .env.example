# Copy to .env and adjust. docker-compose reads this file.
POSTGRES_USER=camtrap
POSTGRES_PASSWORD=camtrap
POSTGRES_DB=camtrap
POSTGRES_PORT=5432

# Used when running the backend/worker/scripts outside Docker, from backend/
# (defaults to SQLite if unset).
# DATABASE_URL=postgresql+psycopg://camtrap:camtrap@localhost:5432/camtrap
# STORAGE_DIR=../data/storage

# Optional single API key for write endpoints (leave empty to disable).
API_KEY=

BATCH_SIZE=20
DETECTION_MIN_CONF=0.05
EVENT_GAP_SECONDS=60
STATIC_MIN_CONF=0.2
STATIC_IOU=0.7
STATIC_MIN_FRACTION=0.1
STATIC_MIN_COUNT=5
AUTO_ACCEPT_CONF=0.80
AUTO_EMPTY_CONF=0.10

# Timestamp OCR of the printed date banner, used when EXIF is missing
OCR_ENABLED=true
OCR_MIN_YEAR=2000
OCR_DATE_ORDER=MDY
OCR_MAX_DAYS_FROM_CAMERA=30
